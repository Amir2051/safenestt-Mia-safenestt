# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter alternative provider (leave disabled if unused)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_REASONING_MODEL=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_CLASSIFICATION_MODEL=
OPENROUTER_SUMMARIZATION_MODEL=
OPENROUTER_REPORT_MODEL=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars

# ── Optional integrations ─────────────────────────────────────────────────────
OMDB_API_KEY=
APP_URL=http://localhost:3000
